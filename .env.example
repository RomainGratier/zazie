# Copy to .env.platform. Keep it private; never overwrite an existing .env.
# Generate each password/secret independently, e.g. openssl rand -hex 32.
POSTGRES_PASSWORD=
MIGRATION_PASSWORD=
APP_DATABASE_PASSWORD=
SESSION_SECRET=

PUBLIC_URL=https://zazie.example.com
COOKIE_SECURE=true
# Comma-separated trusted reverse-proxy IPs/CIDRs as seen by the API.
# Trust only your proxy; never accept forwarded headers from arbitrary clients.
# TRUST_PROXY=
OIDC_ISSUER=https://identity.example.com/realms/organisation
OIDC_CLIENT_ID=zazie
OIDC_CLIENT_SECRET=
OIDC_ALLOW_INSECURE_HTTP=false

# URLs are internal to the Compose network; these defaults are constructed by Compose.
# For managed PostgreSQL, override both DATABASE_URL and MIGRATION_DATABASE_URL.
STORAGE_DRIVER=filesystem
ARTIFACT_MAX_BYTES=10485760
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional, opt-in OpenTelemetry collector; leave unset for no telemetry export.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=zazie
