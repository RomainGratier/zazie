{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "const": "draft-research"
    },
    "sourceCheckedOn": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "hypotheses": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "applicability": {
            "type": "string",
            "minLength": 1
          },
          "evidenceRequirements": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "counterexamples": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "limitations": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "sourceMappings": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "article": {
                  "type": "string",
                  "minLength": 1
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "relationship": {
                  "type": "string",
                  "const": "research-mapping"
                },
                "note": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "article",
                "url",
                "relationship",
                "note"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "title",
          "question",
          "applicability",
          "evidenceRequirements",
          "counterexamples",
          "limitations",
          "sourceMappings"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "status",
    "sourceCheckedOn",
    "hypotheses"
  ],
  "additionalProperties": false,
  "$id": "https://raw.githubusercontent.com/RomainGratier/zazie/main/schemas/hypothesis-pack.v1.json",
  "$comment": "Generated by npm run schemas. The TypeScript runtime additionally checks serialization limits, unique IDs, and Choice probability consistency; JSON Schema cannot express all cross-field invariants."
}
