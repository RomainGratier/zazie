{
  "name": "@romaingratier/zazie",
  "version": "0.1.0",
  "description": "A fixed, open research hypothesis engine for AI system risk signals.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/RomainGratier/zazie.git"
  },
  "bugs": {
    "url": "https://github.com/RomainGratier/zazie/issues"
  },
  "homepage": "https://github.com/RomainGratier/zazie#readme",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./benchmark": {
      "types": "./dist/benchmark.d.ts",
      "import": "./dist/benchmark.js"
    },
    "./schemas/*": "./schemas/*"
  },
  "bin": {
    "zazie": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "schemas",
    "docs",
    "examples",
    "benchmarks",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:package": "npm run build && node scripts/verify-package.mjs",
    "test:live": "node --env-file-if-exists=.env --import tsx scripts/live-smoke.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "schemas": "node --import tsx scripts/generate-schemas.ts",
    "schemas:check": "node --import tsx scripts/generate-schemas.ts --check",
    "check": "npm run typecheck && npm run test:coverage && npm run build && npm run schemas:check && npm run format:check",
    "benchmark": "node --import tsx scripts/benchmark.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "0.6.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.1",
    "@vitest/coverage-v8": "5.0.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "prettier": "3.9.8",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
