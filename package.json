{
  "name": "zazie-workspace",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "dev": "node --conditions=development --import tsx apps/api/src/main.ts",
    "worker": "node --conditions=development --import tsx apps/worker/src/main.ts",
    "db:migrate": "node --conditions=development --import tsx packages/database/src/migrate.ts",
    "bootstrap": "node --conditions=development --import tsx scripts/bootstrap.ts",
    "seed": "node --conditions=development --import tsx scripts/seed.ts",
    "retention": "node --conditions=development --import tsx scripts/retention.ts",
    "build": "pnpm -r --if-present build",
    "typecheck": "tsc --noEmit && pnpm --filter @zazie/web typecheck",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:package": "node scripts/sdk-package-smoke.mjs",
    "openapi": "node --conditions=development --import tsx scripts/generate-openapi.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm format:check",
    "openapi:check": "node --conditions=development --import tsx scripts/generate-openapi.ts --check"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.4",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.1",
    "prettier": "3.9.8",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.1",
    "@zazie/contracts": "workspace:*",
    "@zazie/database": "workspace:*",
    "@zazie/storage": "workspace:*",
    "@zazie/workflow-packs": "workspace:*",
    "@zazie/sdk-typescript": "workspace:*"
  }
}
